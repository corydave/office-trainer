<?xml version="1.0" encoding="UTF-8"?>
<!--
  OFFICE TRAINER - add-in manifest
  This file tells Word, Excel and PowerPoint: "there's an add-in called Office Trainer, it
  lives at this web address, and here's the button to put on the Home tab."
  They read this file once when the add-in is installed. The add-in itself is
  taskpane.html, hosted at the addresses below. It works out which app opened
  it and shows that course (word/, excel/ or powerpoint/).

  If you move the add-in to a different web address, find-and-replace
  https://corydave.github.io/office-trainer/ everywhere in this file.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">

  <!-- A unique ID for this add-in. Never reuse it for a different add-in. -->
  <Id>ecc40387-d2c3-4656-8408-4f89bd934eb4</Id>
  <!--
    Bump this number whenever you change THIS file (button text, icons, web
    addresses). You do NOT need to touch it when you only change taskpane.html,
    the lessons, or the starter files - Word, Excel and PowerPoint load those fresh from the web.
  -->
  <Version>1.5.0.0</Version>
  <ProviderName>Finger Lakes Community College</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Office Trainer"/>
  <Description DefaultValue="Practice Word, Excel and PowerPoint skills on a real file and check your work. Your file never leaves your device."/>
  <IconUrl DefaultValue="https://corydave.github.io/office-trainer/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://corydave.github.io/office-trainer/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://corydave.github.io/office-trainer/"/>

  <!-- "Document" = Word, "Workbook" = Excel, "Presentation" = PowerPoint. -->
  <Hosts>
    <Host Name="Document"/>
    <Host Name="Workbook"/>
    <Host Name="Presentation"/>
  </Hosts>

  <!--
    No <Requirements> here on purpose: a WordApi requirement would hide the
    add-in from Excel and PowerPoint. taskpane.html asks at run time what each
    app supports (WordApi 1.3+ in Word, ExcelApi 1.8+ to open practice files in
    Excel, PowerPointApi 1.1+ to open them in PowerPoint and 1.5+ for Show me)
    and falls back to Download when something is missing.
  -->

  <DefaultSettings>
    <SourceLocation DefaultValue="https://corydave.github.io/office-trainer/taskpane.html"/>
  </DefaultSettings>

  <!--
    ReadWriteDocument: needed to (1) read a copy of the open document,
    workbook or presentation for checking and (2) open the practice file. The add-in cannot
    see any other files.
  -->
  <Permissions>ReadWriteDocument</Permissions>

  <!-- Everything below adds the "Office Trainer" button to the Home tab in Word, Excel and PowerPoint. -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="OfficeTrainer.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="OfficeTrainer.OpenButton">
                  <Label resid="OpenButton.Label"/>
                  <Supertip>
                    <Title resid="OpenButton.Label"/>
                    <Description resid="OpenButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>OfficeTrainerPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
      <!-- The same button for Excel (each app needs its own copy, with its own ids). -->
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="OfficeTrainer.Excel.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="OfficeTrainer.Excel.OpenButton">
                  <Label resid="OpenButton.Label"/>
                  <Supertip>
                    <Title resid="OpenButton.Label"/>
                    <Description resid="OpenButton.Tooltip.Excel"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>OfficeTrainerPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
      <!-- The same button for PowerPoint. -->
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="OfficeTrainer.PowerPoint.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="OfficeTrainer.PowerPoint.OpenButton">
                  <Label resid="OpenButton.Label"/>
                  <Supertip>
                    <Title resid="OpenButton.Label"/>
                    <Description resid="OpenButton.Tooltip.PowerPoint"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>OfficeTrainerPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://corydave.github.io/office-trainer/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://corydave.github.io/office-trainer/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://corydave.github.io/office-trainer/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://corydave.github.io/office-trainer/"/>
        <bt:Url id="Commands.Url" DefaultValue="https://corydave.github.io/office-trainer/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://corydave.github.io/office-trainer/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Office Trainer is ready"/>
        <bt:String id="Group.Label" DefaultValue="Trainer"/>
        <bt:String id="OpenButton.Label" DefaultValue="Office Trainer"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Click Office Trainer on the Home tab to open your practice tasks."/>
        <bt:String id="OpenButton.Tooltip" DefaultValue="Open your Word lessons, practice on a real document, and check your work."/>
        <bt:String id="OpenButton.Tooltip.Excel" DefaultValue="Open your Excel lessons, practice on a real workbook, and check your work."/>
        <bt:String id="OpenButton.Tooltip.PowerPoint" DefaultValue="Open your PowerPoint lessons, practice on a real presentation, and check your work."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
